# 复制为 .env 后修改(.env 不要提交、不要外传)
# ---- 必改 ----
BIND_IP=192.168.1.10                         # 主机的局域网固定 IP;端口只绑定在这块网卡上(Docker 发布的端口不受 ufw 管)
BYCALL_API_KEY=请改成一串随机字符            # 大屏/接口密钥
MQ_CONF=mosquitto.prod.conf                  # 上线必须用:禁止匿名 MQTT
MQTT_USER=host
MQTT_PASSWORD=                               # 填 mosquitto/auth/credentials.json 里 host 的密码
BACKUP_PATH=/mnt/backup/bycall               # 必须是另一块盘(U盘/NAS),不要和数据库同盘
# ---- 可选 ----
BACKUP_KEEP_DAYS=7
# BYCALL_CONFIG=/config/store.json           # 正式门店配置(放在 ./config/store.json)
# ---- 对接伴月轩管理系统(不填则用本地配置)----
# MGMT_URL=http://管理系统地址:端口
# MGMT_STORE_ID=
# MGMT_API_KEY=

# ---- 云备份(可选,强烈建议开启):S3 兼容对象存储(阿里云 OSS / 腾讯云 COS / 华为 OBS / 七牛 / MinIO ...)----
# 备份在主机上先加密再上传,云端只看到密文。备份时段、保留天数在 http://主机IP:8100/backup 页面里设置。
CLOUD_ENDPOINT=                   # 腾讯云 COS 例:https://cos.ap-beijing.myqcloud.com(地域按桶所在地域)
CLOUD_BUCKET=                     # 腾讯云桶名带 APPID 后缀,如 bycall-backup-1250000000
CLOUD_PREFIX=bycall/gaoxin/       # 两家店用不同前缀,避免混在一起
CLOUD_REGION=                     # 如 ap-beijing(与 Endpoint 地域一致)
CLOUD_ACCESS_KEY=                 # 建议新建一个只能读写这个桶的子账号密钥
CLOUD_SECRET_KEY=
CLOUD_PASSPHRASE=                 # 加密口令:随机长字符串。⚠ 必须另存两份,丢了云端备份就打不开
